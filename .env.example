SECRET_KEY=change-me-to-a-strong-random-key
AGENT_PROVIDER=offline
DATABASE_URL=sqlite:///./smart_schedule.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Agent -> Smart Schedule API
AGENT_API_BASE_URL=http://localhost:8000/api/v1
AGENT_API_USER=agent-bot
AGENT_API_PASSWORD=change-me
AGENT_COMPANY_NAME=

# Ollama configuration
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=deepseek-coder-v2:16b
OLLAMA_TEMPERATURE=0.3

#WhatsApp provider
WHATSAPP_PROVIDER=neonize
WHATSAPP_WEBHOOK_SECRET=use-a-long-random-webhook-secret

# Neonize (optional, when WHATSAPP_PROVIDER=neonize)
NEONIZE_CLIENT_NAME=smart-schedule-agent
NEONIZE_SESSION_PATH=

# Twilio (legacy fallback)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# # Meta Cloud API (legacy / unused in most setups)
# META_VERIFY_TOKEN=
# META_WHATSAPP_TOKEN=
# META_PHONE_NUMBER_ID=
# META_APP_SECRET=
# META_API_VERSION=v20.0
